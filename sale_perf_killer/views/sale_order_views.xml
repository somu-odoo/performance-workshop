<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_order_form_perf_killer" model="ir.ui.view">
    <field name="name">sale.order.form.perf.killer</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="full_client_title"/>
      </xpath>
    </field>
  </record>

  <record id="view_order_tree_perf_killer" model="ir.ui.view">
    <field name="name">sale.order.tree.perf.killer</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="full_client_title"/>
      </xpath>
    </field>
  </record>
</odoo>
